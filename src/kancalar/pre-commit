#!/bin/sh
# Herkese açık depo kuralları (CLAUDE.md): sahnelenen dosyaları src/denetle.py ile denetler.
# Etkinleştirme: git config core.hooksPath src/kancalar
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v python >/dev/null 2>&1; then PY=python; else PY=python3; fi
exec "$PY" -E -X utf8 src/denetle.py --kanca
